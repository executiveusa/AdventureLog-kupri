# Public (safe in the browser)
NEXT_PUBLIC_WHATSAPP_NUMBER=      # digits with country code, e.g. 5215512345678
NEXT_PUBLIC_CONTACT_EMAIL=        # where email handoffs go
NEXT_PUBLIC_CREDIT_NAME=          # creative strategist credited on the site
NEXT_PUBLIC_CREDIT_URL=           # her portfolio profile
NEXT_PUBLIC_SITE_URL=             # e.g. https://querencia.app

# Server only (never prefix with NEXT_PUBLIC_)
LEAD_WEBHOOK_URL=                 # receives POSTed leads (n8n, Make, Supabase edge function, ...)
LEAD_WEBHOOK_SECRET=              # sent as "Authorization: Bearer <secret>"
